# ServiceNow
SERVICENOW_INSTANCE_URL=https://dev00000.service-now.com
SERVICENOW_USER=svc_ai_triage
SERVICENOW_PASSWORD=
SERVICENOW_TIMEOUT_S=15
SERVICENOW_MAX_RETRIES=3
# Példányonként ellenőrizendő értékek:
SERVICENOW_RESOLVED_STATE=6
SERVICENOW_CLOSE_CODE=Solved (Permanently)

# Claude
# Üresen hagyva csak a szabályalapú triázs fut.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_S=30

# Autonómia: shadow | assist | autonomous
# Az első indításnál maradjon shadow!
AUTONOMY_MODE=shadow
AUTO_CLOSE_MIN_CONFIDENCE=0.85
AUTO_CLOSE_CATEGORIES=password_reset
AUTO_CLOSE_MIN_PRIORITY_NUMBER=4

# Biztonság
# Generálás: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=
ALLOW_SHARED_SECRET_WEBHOOK=true
ADMIN_TOKEN=
MAX_INPUT_CHARS=4000

# Irányítás és idempotencia
# ASSIGNMENT_GROUPS={"password_reset":"Service Desk","network":"Network Support","security":"Security Operations","other":"Service Desk"}
IDEMPOTENCY_TTL_S=3600
